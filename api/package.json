{
  "name": "mes-fiches-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de synchronisation de l'appli Mes fiches",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
